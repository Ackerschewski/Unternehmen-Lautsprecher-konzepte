{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Ackerschewski_code Design System",
    "version": "1.0-draft",
    "status": "draft"
  },
  "brand": {
    "name": "Ackerschewski_code",
    "logoPolicy": "wordmark-only-no-a-logo"
  },
  "color": {
    "accent": {
      "primary": "#F27216",
      "status": "approved",
      "usage": ["primary-action", "selection", "focus", "active-navigation"]
    },
    "themes": {
      "dark": {
        "status": "approved",
        "background": "#121212",
        "surface": "#1A1A1A",
        "surfaceElevated": "#232323",
        "textPrimary": "#F2F2F2",
        "textSecondary": "#A8A8A8",
        "border": "#333333",
        "accent": "#F27216"
      },
      "light": {
        "status": "approved",
        "background": "#F5F5F5",
        "surface": "#FFFFFF",
        "surfaceElevated": "#FAFAFA",
        "textPrimary": "#1A1A1A",
        "textSecondary": "#666666",
        "border": "#DDDDDD",
        "accent": "#F27216"
      }
    },
    "semanticRolesPending": ["success", "warning", "danger", "info"]
  },
  "spacing": {
    "base": 4,
    "scale": [4, 8, 12, 16, 24, 32, 48]
  },
  "layout": {
    "density": "comfortable-technical",
    "dashboard": "essential-information-only",
    "expertOptions": "progressive-disclosure",
    "avoidNestedCards": true
  },
  "charts": {
    "useOnlyWhenInformative": true,
    "maxPrimaryChartsPerDefaultView": 2,
    "avoidDecorativeCharts": true,
    "avoid3DStatisticalCharts": true
  },
  "themes": {
    "standaloneApps": ["system", "light", "dark"],
    "hostAddons": "follow-host-theme"
  },
  "branding": {
    "prominence": "subtle",
    "preferredLocations": ["about", "start-area", "navigation-footer"]
  },
  "ux": {
    "primaryRule": "essential-first",
    "advancedFeatures": "keep-accessible-but-layered",
    "errors": "state-problem-and-next-action",
    "colorIsNeverOnlySignal": true
  }
}
